#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

// Layer definitions
#define ABC 0
#define NUM 1
#define SYM 2
#define NAV 3
#define UTIL 4

// Home row mods macro
#define HRML(k1,k2,k3,k4) &ht LGUI k1  &ht LALT k2  &ht LCTRL k3  &ht LSHFT k4
#define HRMR(k1,k2,k3,k4) &ht RSHFT k1  &ht RCTRL k2  &ht RALT k3  &ht RGUI k4

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};
&mt {
    quick-tap-ms = <200>;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {

    behaviors {
        // Basic hold-tap. Used in home row mods above (in defines)
		ht: hold_tap {
			label = "hold_tap";
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <100>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
        };

        // Hold-tap behavior for layer with tap-preferred
        blt: blt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <100>;
            bindings = <&mo>, <&kp>;
        };
    
        btht: bluetooth_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <2000>;
            require-prior-idle-ms = <100>;
            bindings = <&btdis>, <&btsel>;
        };

        tdto0: tap_dance_to_abc_layer {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&to ABC>;
        };

    };

    macros {
        // Ctrl+Alt+Cmd macro
        CAC: CAC {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings
                = <&macro_press &kp LCTRL &kp LALT &kp LGUI>
                , <&macro_param_1to1>
                , <&macro_tap &kp MACRO_PLACEHOLDER>
                , <&macro_release &kp LCTRL &kp LALT &kp LGUI>
                ;
        };

        // Ctrl+Shift+Alt macro
        CSA: CSA {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHIFT &kp LALT>
                , <&macro_param_1to1>
                , <&macro_tap &kp MACRO_PLACEHOLDER>
                , <&macro_release &kp LCTRL &kp LSHIFT &kp LALT>
                ;
        };

        // Ctrl+Alt macro
        CA: CA {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings
                = <&macro_press &kp LCTRL &kp LALT>
                , <&macro_param_1to1>
                , <&macro_tap &kp MACRO_PLACEHOLDER>
                , <&macro_release &kp LCTRL &kp LALT>
                ;
        };

        // Hold Ctrl+Cmd+Left Click while key is pressed (for mouse drag window actions)
        ctrl_cmd_hold: ctrl_cmd_hold {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <10>;
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LGUI &mkp LCLK>
                , <&macro_pause_for_release>
                , <&macro_release &mkp LCLK &kp LCTRL &kp LGUI>
                ;
        };
    
        btsel: bluetooth_select {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings
                = <&macro_param_1to2>
                , <&macro_tap &bt BT_SEL MACRO_PLACEHOLDER>
                ;
        };

        btdis: bluetooth_disconnect {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings
                = <&macro_param_1to2>
                , <&macro_tap &bt BT_DISC MACRO_PLACEHOLDER>
                ;
        };
    }; // End of macros

    conditional_layers {
	    compatible = "zmk,conditional-layers";
		
	    tri_layer {
		    if-layers = <NUM NAV>;
		    then-layer = <UTIL>;
	    };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "ABC";
            display-name = "ABC";
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &kp GRAVE     &kp N1        &kp N2        &kp N3        &kp N4        &kp N5            &kp N6        &kp N7        &kp N8        &kp N9        &kp N0        &kp DEL
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp TAB       &kp Q         &kp W         &kp F         &kp P         &kp B             &kp J         &kp L         &kp U         &kp Y         &kp SQT       &kp BSLH
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp LSFT      HRML(A,           R,            S,            T)        &kp G             &kp M         HRMR(N,           E,            I,            O)        &kp RSHFT
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp LCTRL     &kp Z         &kp X         &kp C         &kp D         &kp V             &kp K         &kp H         &kp COMMA     &kp DOT       &kp FSLH      &kp ENTER
// ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
//                                           ╭─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────╮
                                              &mo NUM       &kp TAB       &kp ENTER         &kp SPACE     &kp DEL
//                                           ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────╯
//                                                         ╭─────────────┬─────────────╮   ╭─────────────╮
                                                            &mo NAV       &kp LSHIFT        &kp RSHIFT
//                                                         ╰─────────────┴─────────────╯   ╰─────────────╯
            >;
        };

    num_layer {
      label = "NUM";
      display-name = "NUM";
      bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &kp F1        &kp F2        &kp F3        &kp F4        &kp F5            &kp F6        &kp F7        &kp F8        &kp F9        &kp F10       &kp F11       &kp F12
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp LA(TAB)   &kp LGUI      &kp LALT      &kp LCTRL     &mkp MB4      &mkp MB5          &kp LPAR      &kp N7         &kp N8        &kp N9       &kp FSLH      &kp DEL
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp RCTRL     &kp LG(A)     &ctrl_cmd_hold &mkp RCLK    &mkp LCLK     &mkp MCLK         &kp RPAR      &kp N4         &kp N5         &kp N6      &kp MINUS     &kp EQUAL
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp LSFT      &kp Z         &kp X         &kp C         &kp D         &mo NAV           &kp STAR      &kp N1         &kp N2         &kp N3      &kp PLUS      &kp ENTER
// ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
//                                           ╭─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────╮
                                              &trans        &kp TAB       &kp ENTER         &kp N0        &kp DOT
//                                           ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────╯
//                                                         ╭─────────────┬─────────────╮   ╭─────────────╮
                                                            &mo NAV       &kp LSHIFT        &kp RSHIFT
//                                                         ╰─────────────┴─────────────╯   ╰─────────────╯
      >;
    };

    sym_layer {
      label = "SYM";
      display-name = "SYM";
      bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &kp LA(F1)    &kp LA(F2)    &kp LA(F3)    &kp LA(F4)    &kp LA(F5)    &kp LA(F6)        &kp LA(F7)    &kp LA(F8)    &kp LA(F9)    &kp LA(F10)   &kp LA(F11)   &kp LA(F12)
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &none         &CA Q         &CA W         &CA E         &CA R         &CA T             &kp CARET     &kp MINUS     &kp EQUAL     &kp BSLH      &kp TILDE     &CAC F12
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp CAPS      &CA A         &CA S         &CA D         &CA F         &CA G             &kp COLON     &kp LPAR      &kp RPAR      &kp PLUS      &kp SEMI      &kp RSHFT
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &trans        &CA Z         &CA X         &CA C         &CA V         &CSA F1           &kp PIPE      &kp EXCL      &kp AT        &kp HASH      &kp GRAVE     &kp LG(L)
// ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
//                                           ╭─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────╮
                                              &mo NUM       &kp LBKT      &kp RBKT          &kp LBRC      &kp RBRC
//                                           ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────╯
//                                                         ╭─────────────┬─────────────╮   ╭─────────────╮
                                                            &mo NAV       &kp LSHIFT        &kp RSHIFT
//                                                         ╰─────────────┴─────────────╯   ╰─────────────╯
      >;
    };

    nav_layer {
      label = "NAV";
      display-name = "NAV";
      bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &kp ESC       &kp F1        &kp F2        &kp F3        &kp F4        &kp F5            &kp F6        &kp F7        &kp F8        &kp F9        &kp F10       &trans
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &trans        &trans       &CAC W        &kp C_VOL_UP  &kp LG(MINUS) &kp LG(EQUAL)      &kp PG_UP     &kp HOME      &kp UP        &kp END       &kp PG_UP     &trans
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &trans        &none         &kp C_PREV    &kp C_PP      &kp C_NEXT    &kp LG(N0)        &kp PG_DN     &kp LEFT      &kp DOWN      &kp RIGHT     &kp PG_DN     &trans
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &trans        &tdto0        &none         &kp C_VOL_DN  &none         &kp F             &kp RALT      &kp HOME      &kp INS       &kp END       &none         &tdto0
// ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯

//                                           ╭─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────╮
                                              &mo NUM       &kp SPACE     &kp RIGHT         &kp SPACE     &kp DEL
//                                           ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────╯
//                                                         ╭─────────────┬─────────────╮   ╭─────────────╮
                                                            &trans        &kp LEFT          &kp RSHIFT
//                                                         ╰─────────────┴─────────────╯   ╰─────────────╯
      >;
    };

    util_layer {
      label = "UTIL";
      display-name = "UTIL";
      bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &trans        &trans        &trans        &trans        &trans        &trans            &trans        &trans        &trans        &trans        &trans        &trans
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &trans        &trans        &trans        &trans        &trans        &trans            &trans        &trans        &trans        &trans        &trans        &trans
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &trans        &trans        &trans        &trans        &trans        &trans            &trans        &btht 0 0     &btht 1 1     &btht 2 2     &btht 3 3     &btht 4 4
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &trans        &trans        &trans        &trans        &trans        &trans            &trans        &out OUT_TOG  &trans        &trans        &trans        &bt BT_CLR
// ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯

//                                           ╭─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────╮
                                              &trans        &trans        &kp trans         &bt BT_PRV    &bt BT_NXT
//                                           ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────╯
//                                                         ╭─────────────┬─────────────╮   ╭─────────────╮
                                                            &trans        &kp LSHIFT        &kp RSHIFT
//                                                         ╰─────────────┴─────────────╯   ╰─────────────╯
      >;
    };
  };
};
